<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PikPak VR"
        android:textSize="28sp"
        android:textColor="#e94560"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="从 mypikpak.com 网页版获取 Token:\nF12 → Application → Local Storage → access_token"
        android:textColor="#aaa"
        android:textSize="12sp"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="粘贴 Access Token"
        android:textColorHint="#888"
        android:textColor="#fff"
        android:backgroundTint="#444"
        android:inputType="textMultiLine"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="进入 VR"
        android:backgroundTint="#e94560"
        android:textColor="#fff"/>

</LinearLayout>
